<Window x:Class="OrgTechApp.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Height="570" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Border Style="{StaticResource CardBorder}" Padding="24">
            <StackPanel>
                <TextBlock Text="Новый пользователь" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Роль USER назначается автоматически."
                           Style="{StaticResource MutedText}" Margin="0,4,0,18"/>

                <TextBlock Text="Логин *" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtLogin" Margin="0,0,0,10"/>

                <TextBlock Text="Электронная почта" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtEmail" Margin="0,0,0,10"/>

                <TextBlock Text="Пароль *" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,10"/>

                <TextBlock Text="Повтор пароля *" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="txtConfirm" Margin="0,0,0,14"/>

                <Button Content="Зарегистрироваться"
                        Style="{StaticResource PrimaryButton}"
                        Height="38" Click="btnRegister_Click" Width="166"/>
                <Button Content="Отмена"
                        Style="{StaticResource SecondaryButton}"
                        Height="34" Click="btnCancel_Click" Width="90"/>

                <TextBlock x:Name="txtStatus"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
