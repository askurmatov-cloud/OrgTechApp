<Window x:Class="OrgTechApp.RequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заявки"
        Height="760" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="lblTitle" Text="Заявки на обслуживание" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="lblSubtitle" Text="Заявки на ремонт, обслуживание и замену"
                       Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" x:Name="pnlCreate" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Новая заявка" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Оборудование *" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="cmbRequestEquipment" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Тип заявки *" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="cmbRequestType" DisplayMemberPath="Name" SelectedValuePath="Code"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Описание *" Style="{StaticResource FormLabel}" Margin="0,8,0,0"/>
                <TextBox x:Name="txtRequestDescription" Height="58" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                <Button Content="Отправить заявку" Style="{StaticResource PrimaryButton}"
                        Width="170" HorizontalAlignment="Left" Margin="0,8,0,0" Click="btnCreateRequest_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <ComboBox x:Name="cmbFilterStatus" Width="180" DisplayMemberPath="Name"
                          SelectedValuePath="Code" SelectionChanged="cmbFilterStatus_SelectionChanged"/>
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="btnRefresh_Click"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" x:Name="dgRequests" AutoGenerateColumns="False" RowHeight="38"
                  SelectionChanged="dgRequests_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding DataSozdaniya, StringFormat=dd.MM.yyyy HH:mm}" Width="125"/>
                <DataGridTextColumn Header="Инв. №" Binding="{Binding InventarnyyNomer}" Width="100"/>
                <DataGridTextColumn Header="Оборудование" Binding="{Binding Naimenovanie}" Width="160"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding TipNaimenovanie}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusNaimenovanie}" Width="100"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding AvtorLogin}" Width="100"/>
                <DataGridTextColumn Header="Исполнитель" Binding="{Binding IspolnitelLogin}" Width="110"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Opisanie}" Width="*"/>
                <DataGridTextColumn Header="Ответ" Binding="{Binding KommentariyAdministratora}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" x:Name="pnlProcess" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock x:Name="lblSelectedRequest" Text="Выберите заявку"
                               Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                    <TextBlock Text="Комментарий администратора" Style="{StaticResource FormLabel}" Margin="0,8,0,0"/>
                    <TextBox x:Name="txtAdminComment" Height="42" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="150" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="Взять в работу" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Click="btnTake_Click"/>
                    <Button Content="Выполнена" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Click="btnComplete_Click"/>
                    <Button Content="Отклонить" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Stretch" Click="btnReject_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
