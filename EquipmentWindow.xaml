<Window x:Class="OrgTechApp.EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оборудование"
        Height="760" Width="1220"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Оборудование" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Список оргтехники, ответственные лица и фотографии"
                           Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnAdd" Content="Добавить" Style="{StaticResource PrimaryButton}" Click="btnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Style="{StaticResource SecondaryButton}" Click="btnEdit_Click"/>
                <Button x:Name="btnOperate" Content="Передать / списать" Style="{StaticResource SecondaryButton}" Click="btnOperate_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,12">
            <WrapPanel>
                <TextBox x:Name="txtSearch" Width="280" Margin="4"
                         ToolTip="Наименование, модель, серийный или инвентарный номер"
                         TextChanged="txtSearch_TextChanged"/>
                <ComboBox x:Name="cmbStatus" Width="170" Margin="4"
                          DisplayMemberPath="Name" SelectedValuePath="Code"
                          SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="cmbDepartment" Width="210" Margin="4"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="Filter_SelectionChanged"/>
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="btnRefresh_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="dgEquipment"
                      AutoGenerateColumns="False" RowHeight="56"
                      SelectionChanged="dgEquipment_SelectionChanged"
                      MouseDoubleClick="dgEquipment_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Фото" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="56" Height="42" CornerRadius="4"
                                        Background="#EEF3F8" ClipToBounds="True">
                                    <Image Source="{Binding FotoPut, Converter={StaticResource ImagePathConverter}}"
                                           Stretch="Uniform"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Инв. №" Binding="{Binding InventarnyyNomer}" Width="100"/>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Naimenovanie}" Width="150"/>
                    <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="130"/>
                    <DataGridTextColumn Header="Серийный №" Binding="{Binding SeriynyyNomer}" Width="105"/>
                    <DataGridTextColumn Header="Состояние" Binding="{Binding StatusNaimenovanie}" Width="105"/>
                    <DataGridTextColumn Header="Ответственный" Binding="{Binding FIO}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="12,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Height="200" CornerRadius="8" Background="#EEF3F8" ClipToBounds="True">
                            <Image x:Name="imgPhoto" Stretch="Uniform"/>
                        </Border>

                        <TextBlock x:Name="lblName" Text="Выберите оборудование"
                                   Style="{StaticResource SectionTitle}" Margin="0,12,0,2"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="lblStatus" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>

                        <TextBlock Text="Инвентарный номер" Style="{StaticResource FormLabel}"/>
                        <TextBlock x:Name="lblInventory" FontWeight="SemiBold"/>

                        <TextBlock Text="Модель" Style="{StaticResource FormLabel}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="lblModel" TextWrapping="Wrap"/>

                        <TextBlock Text="Серийный номер" Style="{StaticResource FormLabel}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="lblSerial"/>

                        <TextBlock Text="Ответственный" Style="{StaticResource FormLabel}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="lblFio" TextWrapping="Wrap"/>

                        <TextBlock Text="Подразделение" Style="{StaticResource FormLabel}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="lblDepartment" TextWrapping="Wrap"/>

                        <TextBlock Text="Дата поступления" Style="{StaticResource FormLabel}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="lblReceived"/>

                        <TextBlock Text="Гарантия" Style="{StaticResource FormLabel}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="lblWarranty"/>

                        <TextBlock Text="Стоимость" Style="{StaticResource FormLabel}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="lblCost"/>

                        <TextBlock Text="Комментарий" Style="{StaticResource FormLabel}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="lblComment" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
